# ==============================================================================
# Creative Interiors & Woodcraft — Environment Configuration
# ==============================================================================

# 1. Public Site Configuration
# Canonical public site origin used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://creativeinteriorsandwoodcraft.think2xcreate.com

# 2. Durable Enquiry Delivery (Server-Side)
# In production, at least one durable destination (Webhook or Resend) MUST be configured.

# A. Webhook / CRM / Lead Management endpoint
# Accepts a JSON POST payload: Zapier, Make, n8n, Google Apps Script, custom CRM.
ENQUIRY_WEBHOOK_URL=

# Optional shared secret sent as the x-webhook-secret header to verify payload authenticity.
ENQUIRY_WEBHOOK_SECRET=

# B. Email Delivery with Resend
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_EMAIL=interiorscreative083@gmail.com
ENQUIRY_FROM_EMAIL=Enquiries <onboarding@resend.dev>

# 3. Distributed Rate Limiting & Idempotency Store (Multi-Instance / Serverless)
# Connect an Upstash Redis or Vercel KV database to share rate limiting and prevent
# duplicate submissions across serverless lambda instances.
# When omitted, the server safely falls back to an in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Or Vercel KV equivalents:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# 4. Optional Social & Map Embed Overrides
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
